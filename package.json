{
    "name": "printforge",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:frappe": "vite build --mode frappe",
        "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "vitest run",
        "build:wasm": "wasm-pack build rust/guides-wasm --target web --release --out-dir ../../src/wasm/guides --no-pack",
        "build:pdfgen": "cargo build --release --manifest-path rust/pdfgen/Cargo.toml",
        "pdf": "rust\\pdfgen\\target\\release\\pdfgen.exe"
    },
    "dependencies": {
        "html-to-image": "^1.11.13",
        "quill": "^1.3.7",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "jsdom": "^25.0.1",
        "vite": "^5.2.0",
        "vitest": "^2.1.9"
    }
}
